# Development-only values. Replace both secrets before any non-local deployment.
JWT_SECRET=local-only-replace-with-a-random-secret-at-least-32-bytes
INTERNAL_API_TOKEN=local-only-internal-service-token
# Use a long alphanumeric value (it is inserted into PostgreSQL URLs without URL encoding).
POSTGRES_PASSWORD=local-development-password

# Optional SMTP configuration for notification-service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
